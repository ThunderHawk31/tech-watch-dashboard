    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst sectors = data.sectors || [];\nconst topArticles = data.top_articles || [];\n\nconst dateEnd = new Date().toLocaleDateString('fr-FR');\nconst dateStart = new Date(Date.now() - 14 * 24 * 60 * 60 * 1000).toLocaleDateString('fr-FR');\n\nconst sentimentColor = (s) => s === 'Positif' ? '#22c55e' : s === 'Négatif' ? '#ef4444' : '#a3a3a3';\n\nconst sectorRows = sectors.map(s => `\n  <tr style=\"border-top:1px solid #1a1a1a;\">\n    <td style=\"padding:10px 0; color:#e8e8e8; font-size:13px; font-family:'DM Sans',Arial,sans-serif; font-weight:500;\">${s.sector}</td>\n    <td style=\"padding:10px 0; color:#a3a3a3; font-size:12px; font-family:'DM Mono',monospace; text-align:center;\">${s.article_count}</td>\n    <td style=\"padding:10px 0; color:#f59e0b; font-size:13px; text-align:center; font-weight:500;\">${s.avg_importance}/5</td>\n    <td style=\"padding:10px 0; text-align:center;\">\n      <span style=\"color:#22c55e; font-size:12px; font-family:'DM Mono',monospace;\">${s.positive_count}+</span>\n      <span style=\"color:#555; font-size:12px;\"> / </span>\n      <span style=\"color:#ef4444; font-size:12px; font-family:'DM Mono',monospace;\">${s.negative_count}-</span>\n    </td>\n    <td style=\"padding:10px 0; text-align:right;\">\n      <span style=\"color:#f59e0b; font-size:13px; font-weight:600; font-family:'DM Mono',monospace;\">${s.heat_score}</span>\n    </td>\n  </tr>`).join('');\n\nconst articleRows = topArticles.map((a, i) => `\n  <tr style=\"${i > 0 ? 'border-top:1px solid #1a1a1a;' : ''}\">\n    <td style=\"padding:10px 0;\">\n      <a href=\"${a.url}\" style=\"color:#e8e8e8; font-size:13px; text-decoration:none; font-family:'DM Sans',Arial,sans-serif; line-height:1.4; display:block;\">${a.title}</a>\n      <div style=\"margin-top:4px;\">\n        <span style=\"font-family:'DM Mono',monospace; font-size:11px; color:#555; text-transform:uppercase;\">${a.sector}</span>\n        &nbsp;·&nbsp;\n        <span style=\"font-family:'DM Mono',monospace; font-size:11px; color:${sentimentColor(a.sentiment)};\">${a.sentiment}</span>\n      </div>\n    </td>\n    <td style=\"padding:10px 0 10px 12px; text-align:right; vertical-align:top; white-space:nowrap;\">\n      <span style=\"color:#f59e0b; font-size:14px; font-family:'DM Mono',monospace;\">${'★'.repeat(a.importance)}${'☆'.repeat(5 - a.importance)}</span>\n    </td>\n  </tr>`).join('');\n\nconst html = `<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n</head>\n<body style=\"margin:0; padding:0; background-color:#000;\">\n\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:collapse; max-width:520px; background-color:#0f0f0f; border-radius:12px; border:1px solid #222; font-family:'DM Sans',Arial,sans-serif; color:#e8e8e8;\">\n  <tbody>\n\n  <tr>\n    <td style=\"padding:24px 24px 0 24px; border-bottom:1px solid #1e1e1e;\">\n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:collapse;\">\n        <tr>\n          <td style=\"padding-bottom:8px;\">\n            <span style=\"font-family:'DM Mono',monospace; font-size:11px; color:#666; text-transform:uppercase; letter-spacing:1.5px;\">TechWatch · Digest Bimensuel</span>\n            &nbsp;<span style=\"display:inline-block; background:#f59e0b; width:6px; height:6px; border-radius:50%; vertical-align:middle;\"></span>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding-bottom:6px;\">\n            <span style=\"font-size:17px; font-weight:600; color:#fff; letter-spacing:-0.2px;\">Résumé des 14 derniers jours</span>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding-bottom:20px;\">\n            <span style=\"font-family:'DM Mono',monospace; font-size:12px; color:#555;\">${dateStart} → ${dateEnd}</span>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n  <tr>\n    <td style=\"padding:20px 24px 4px 24px;\">\n      <span style=\"font-family:'DM Mono',monospace; font-size:11px; color:#666; text-transform:uppercase; letter-spacing:1px;\">Chaleur par secteur</span>\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:0 24px 4px 24px;\">\n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:collapse;\">\n        <tr>\n          <td style=\"padding:6px 0; color:#555; font-size:11px; font-family:'DM Mono',monospace; text-transform:uppercase; letter-spacing:0.5px;\">Secteur</td>\n          <td style=\"padding:6px 0; color:#555; font-size:11px; font-family:'DM Mono',monospace; text-transform:uppercase; text-align:center;\">Articles</td>\n          <td style=\"padding:6px 0; color:#555; font-size:11px; font-family:'DM Mono',monospace; text-transform:uppercase; text-align:center;\">Moy.</td>\n          <td style=\"padding:6px 0; color:#555; font-size:11px; font-family:'DM Mono',monospace; text-transform:uppercase; text-align:center;\">Sentiment</td>\n          <td style=\"padding:6px 0; color:#555; font-size:11px; font-family:'DM Mono',monospace; text-transform:uppercase; text-align:right;\">Heat</td>\n        </tr>\n        ${sectorRows}\n      </table>\n    </td>\n  </tr>\n\n  <tr>\n    <td style=\"padding:20px 24px 4px 24px; border-top:1px solid #1e1e1e;\">\n      <span style=\"font-family:'DM Mono',monospace; font-size:11px; color:#666; text-transform:uppercase; letter-spacing:1px;\">Top articles</span>\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:4px 24px 20px 24px;\">\n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:collapse;\">\n        ${articleRows}\n      </table>\n    </td>\n  </tr>\n\n  <tr>\n    <td style=\"padding:16px 24px; border-top:1px solid #1e1e1e; text-align:center;\">\n      <a href=\"https://techwatch.fr\" target=\"_blank\" style=\"display:inline-block; background:#fff; color:#0f0f0f; padding:10px 28px; text-decoration:none; border-radius:7px; font-weight:600; font-size:13px; font-family:'DM Sans',Arial,sans-serif;\">\n        Voir tout sur TechWatch →\n      </a>\n    </td>\n  </tr>\n\n  </tbody>\n</table>\n\n</body>\n</html>`;\n\nreturn [{ json: { html } }];"
      },
