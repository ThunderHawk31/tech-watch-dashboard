    {
      "parameters": {
        "jsCode": "const feeds = [\n  \"TechCrunch\", \"OReilly\", \"TheHackerNews\",\n  \"CoinDesk\", \"HuggingFace\", \"LesEchos\", \"CERTFR\"\n];\n\n// Flux RSS — vrais noms des nœuds\nconst fluxNodes = {\n  \"TechCrunch\":     \"Test Flux RSS Techcrunch\",\n  \"OReilly\":        \"Test Flux RSS O'Reilly\",\n  \"TheHackerNews\":  \"Test Flux RSS TheHackerNews\",\n  \"CoinDesk\":       \"Test Flux RSS CoinDesk\",\n  \"HuggingFace\":    \"Test Flux RSS HuggingFace\",\n  \"LesEchos\":       \"Test Flux RSS Les Echos\",\n  \"CertFR\":         \"Test Flux RSS Cert-FR\"\n};\n\nconst flux_status = {};\nconst deadFeeds = [];\n\nfor (const [name, nodeName] of Object.entries(fluxNodes)) {\n  try {\n    const d = $node[nodeName].json;\n    flux_status[name] = (!d.error && JSON.stringify(d).length > 100) ? 'ok' : 'dead';\n  } catch(e) {\n    flux_status[name] = 'dead';\n  }\n  if (flux_status[name] === 'dead') deadFeeds.push(name);\n}\n\n// Stats Supabase\nconst articles24h = $(\"Stats Supabase articles\").all().length;\nconst skipped24h  = $(\"Stats Supabase skipped\").all().length;\n\nconsole.log('Flux:', flux_status);\nconsole.log('Articles 24h:', articles24h, '| Skipped:', skipped24h);\n\nreturn {\n  json: {\n    articles_24h:  articles24h,\n    skipped_24h:   skipped24h,\n    flux_status,\n    dead_feeds:    deadFeeds,\n    has_dead:      deadFeeds.length > 0,\n    no_ingestion:  articles24h === 0,\n    alert_needed:  deadFeeds.length > 0 || articles24h === 0\n  }\n};"
      },
