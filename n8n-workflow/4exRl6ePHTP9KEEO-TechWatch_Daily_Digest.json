    {
      "parameters": {
        "jsCode": "const articles = $input.all().map(i => i.json);\n\nif (articles.length === 0) {\n  return [{ json: { skip: true } }];\n}\n\nconst topArticles = articles.slice(0, 5).map(a => ({\n  titre: a.title,\n  importance: a.importance,\n  secteur: a.sector,\n  url: a.url\n}));\n\nconst sectors = articles.reduce((acc, a) => {\n  acc[a.sector] = (acc[a.sector] || 0) + 1;\n  return acc;\n}, {});\n\nconst articlesText = articles.slice(0, 10).map((a, i) =>\n  `${i+1}. [${a.importance}/5] ${a.title} (${a.sector})`\n).join('\\n');\n\nreturn [{ json: {\n  skip: false,\n  topArticles,\n  sectors,\n  prompt: `Tu es un analyste de veille tech/finance. Voici les ${articles.length} articles importants du jour :\\n\\n${articlesText}\\n\\nRédige un digest en 3-4 phrases qui synthétise les grandes tendances du jour. Sois factuel, concis, en français. Mets en avant les thèmes transversaux si plusieurs articles convergent.`\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "84ce7369-21ee-4f0d-b6f6-3a5c27de0973",
      "name": "Préparer prompt"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "4b2d72a8-cb0a-424e-905c-452493da992c",
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
