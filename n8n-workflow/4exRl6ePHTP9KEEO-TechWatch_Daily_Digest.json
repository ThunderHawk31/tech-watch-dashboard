    },
    {
      "parameters": {
        "jsCode": "const haiku = $input.first().json;\nconst prep = $node[\"Préparer prompt\"].json;\nconst summary = haiku.content?.[0]?.text?.trim() || '';\n\nreturn [{ json: {\n  date: new Date().toISOString().split('T')[0],\n  summary,\n  top_articles: prep.topArticles,\n  sectors: prep.sectors\n}}];"
      },
